<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#050505">
<title>VLM SHOP</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root {
  --bg: #050505;
  --card: #151515;
  --blue: #1677FF;
  --line: #202b3b;
  --text: #ffffff;
  --muted: #a0a7b4;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
button, input { font: inherit; }
button { cursor: pointer; }
.app {
  max-width: 950px;
  margin: auto;
  padding: 18px 15px 100px;
}
.top {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}
.logo {
  flex: 1;
  font-size: 25px;
  font-weight: 900;
  letter-spacing: 1px;
}
.logo span { color: var(--blue); }
.icon {
  width: 44px;
  height: 44px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--card);
  color: white;
  font-size: 21px;
}
.icon:active, .btn:active { background: #075bd0; }
.search {
  width: 100%;
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--card);
  color: white;
  outline: none;
}
.search:focus, .field:focus {
  border-color: var(--blue);
}
.section-title {
  margin: 25px 0 5px;
  font-size: 22px;
  font-weight: 800;
}
.subtitle { color: var(--muted); font-size: 13px; }
.chips, .sorts {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 14px 0;
}
.chip, .sort {
  flex-shrink: 0;
  padding: 10px 15px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--card);
  color: white;
}
.chip.active, .sort.active {
  background: var(--blue);
  border-color: var(--blue);
}
.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.product {
  min-width: 0;
  overflow: hidden;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 17px;
  cursor: pointer;
  transition: border-color .2s, transform .2s;
}
.product:active { transform: scale(.98); }
.product:hover { border-color: var(--blue); }
.pic {
  width: 100%;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0b0d12;
  color: #737e90;
  overflow: hidden;
}
.pic img { width: 100%; height: 100%; object-fit: cover; }
.placeholder { font-size: 42px; color: var(--blue); }
.pbody { padding: 12px; }
.name { font-size: 15px; font-weight: 750; overflow-wrap: anywhere; }
.stock { margin-top: 7px; font-size: 12px; color: #36a3ff; }
.stock.out { color: #888; }
.price { margin-top: 9px; font-size: 18px; font-weight: 850; }
.empty { padding: 40px 10px; text-align: center; color: var(--muted); }
.btn {
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 12px;
  background: var(--blue);
  color: white;
  font-weight: 750;
  transition: background .15s;
}
.btn:hover { background: #0868ed; }
.cartbar {
  position: fixed;
  display: none;
  align-items: center;
  justify-content: space-between;
  left: 12px;
  right: 12px;
  bottom: 12px;
  max-width: 920px;
  margin: auto;
  padding: 16px;
  background: var(--blue);
  color: white;
  border-radius: 15px;
  font-weight: 800;
  z-index: 10;
  box-shadow: 0 5px 30px #0009;
  cursor: pointer;
}
.cartbar.show { display: flex; }
.overlay, .modal {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: none;
  background: #000b;
}
.overlay.show, .modal.show { display: block; }
.sheet {
  position: absolute;
  top: 0;
  right: 0;
  width: min(88%, 400px);
  height: 100%;
  overflow-y: auto;
  padding: 24px;
  background: #101116;
  border-left: 1px solid var(--line);
}
.close {
  float: right;
  border: 0;
  background: none;
  color: white;
  font-size: 29px;
}
.menuitem {
  width: 100%;
  padding: 17px 0;
  text-align: left;
  border: 0;
  border-bottom: 1px solid var(--line);
  background: none;
  color: white;
}
.menuitem:hover { color: #58a0ff; }
.modal {
  z-index: 30;
  overflow-y: auto;
  padding: 20px 12px;
}
.modal.
